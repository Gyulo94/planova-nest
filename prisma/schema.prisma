generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action      String
  description String
  metadata    Json?
  workspaceId String?  @db.Uuid
  projectId   String?  @db.Uuid
  taskId      String?  @db.Uuid
  userId      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  task        Task[]

  @@index([createdAt])
  @@index([projectId])
  @@index([taskId])
  @@index([userId])
  @@index([workspaceId])
}

model Approval {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String   @db.Uuid
  userId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@index([taskId])
}

model Attachment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  taskId    String   @db.Uuid
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content   String
  taskId    String   @db.Uuid
  userId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([taskId])
}

model Epic {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  epicNumber  Int
  title       String
  icon        String?
  description String?
  progress    Int       @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  workspaceId String    @db.Uuid
  projectId   String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project?   @relation(fields: [projectId], references: [id])
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
  milestoneId String?    @db.Uuid
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])
  tasks       Task[]
  user        User?      @relation(fields: [userId], references: [id])
  userId      String?

  @@index([projectId])
  @@index([workspaceId])
}

model Idea {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  description      String?
  status           IdeaStatus @default(RAW)
  priority         Priority   @default(MEDIUM)
  workspaceId      String     @db.Uuid
  projectId        String?    @db.Uuid
  createdById      String
  promotedToTaskId String?    @db.Uuid
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             User       @relation(fields: [createdById], references: [id])
  project          Project?   @relation(fields: [projectId], references: [id])
  task             Task?      @relation(fields: [promotedToTaskId], references: [id])
  workspace        Workspace  @relation(fields: [workspaceId], references: [id])
  labelId          String?    @db.Uuid
  label            Label?     @relation(fields: [labelId], references: [id])

  @@index([createdAt])
  @@index([createdById])
  @@index([priority])
  @@index([projectId])
  @@index([status])
  @@index([workspaceId])
}

model Image {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url         String
  workspaceId String?    @unique @db.Uuid
  projectId   String?    @unique @db.Uuid
  taskId      String?    @db.Uuid
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([workspaceId])
  @@index([taskId])
}

model Label {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  bgColor   String
  textColor String
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  ideas     Idea[]

  @@unique([projectId, name])
  @@index([name])
  @@index([projectId])
}

model Milestone {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  milestoneNumber Int
  icon            String?
  description     String?
  dueDate         DateTime
  completed       Boolean   @default(false)
  workspaceId     String    @db.Uuid
  projectId       String    @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  project         Project   @relation(fields: [projectId], references: [id])
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  epics           Epic[]

  @@index([completed])
  @@index([dueDate])
  @@index([projectId])
  @@index([workspaceId])
}

model Project {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  description   String?
  workspaceId   String          @db.Uuid
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  epic          Epic[]
  idea          Idea[]
  label         Label[]
  milestone     Milestone[]
  image         Image?
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectMember ProjectMember[]
  task          Task[]

  @@index([workspaceId])
}

model ProjectMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @db.Uuid
  userId    String
  role      Role
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([joinedAt])
  @@index([projectId])
}

model Subtask {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  completed Boolean @default(false)
  order     Int     @default(0)
  taskId    String  @db.Uuid
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([completed])
  @@index([taskId])
}

model Task {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskNumber        Int
  title             String
  description       String?
  progress          Int          @default(0)
  status            TaskStatus   @default(TODO)
  priority          Priority     @default(MEDIUM)
  startDate         DateTime?
  dueDate           DateTime?
  completedAt       DateTime?
  order             Int          @default(1000)
  projectId         String       @db.Uuid
  epicId            String?      @db.Uuid
  requiredApprovals Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  approval          Approval[]
  attachment        Attachment[]
  comment           Comment[]
  idea              Idea[]
  images            Image[]
  subtask           Subtask[]
  epic              Epic?        @relation(fields: [epicId], references: [id])
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId        String?
  assignee          User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  labelId           String?      @db.Uuid
  label             Label?       @relation(fields: [labelId], references: [id])
  activity          Activity[]

  @@index([dueDate])
  @@index([priority])
  @@index([projectId])
  @@index([projectId, status, order])
  @@index([status])
}

model User {
  id            String   @id
  email         String   @unique
  emailVerified Boolean  @default(true)
  name          String?
  image         String?
  provider      Provider @default(LOCAL)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  activity        Activity[]
  approval        Approval[]
  comment         Comment[]
  epic            Epic[]
  idea            Idea[]
  projectMember   ProjectMember[]
  assignedTasks   Task[]            @relation("TaskAssignee")
  workspace       Workspace[]
  workspaceMember WorkspaceMember[]
  accounts        Account[]

  @@index([createdAt])
  @@index([email])
}

model Account {
  id          String   @id
  accountId   String
  providerId  String
  userId      String
  accessToken String?  @db.Text
  scope       String?
  password    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Workspace {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  inviteCode      String?           @unique
  ownerId         String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  epic            Epic[]
  idea            Idea[]
  image           Image?
  milestone       Milestone[]
  project         Project[]
  user            User              @relation(fields: [ownerId], references: [id])
  workspaceMember WorkspaceMember[]
}

model WorkspaceMember {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @db.Uuid
  userId      String
  role        Role
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([joinedAt])
  @@index([workspaceId])
}

enum Provider {
  LOCAL
  GOOGLE
  KAKAO
}

enum IdeaStatus {
  RAW
  TO_CONSIDER
  REFINED
  PROMOTED
  ARCHIVED
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}
